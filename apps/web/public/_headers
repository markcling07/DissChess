# Response headers for static hosts that read this file, such as Cloudflare Pages and Netlify.

# The service worker decides what's cached, so it must always be fetched fresh to deliver updates.
/sw.js
  Cache-Control: no-cache

# Built files have unique names, so they can be cached for a long time.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
